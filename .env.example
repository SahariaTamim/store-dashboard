# Copy this to .env — NEVER commit .env to GitHub

# Dashboard login password (you choose anything)
VITE_DASHBOARD_PASSWORD=your_password_here

# Google Sheet ID
# From your Sheet URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
VITE_SHEET_ID=your_google_sheet_id_here

# Google API Key (free, read-only)
# Get from: console.cloud.google.com → APIs → Credentials → + Create → API Key
# Enable: "Google Sheets API" for the project
VITE_GOOGLE_API_KEY=AIzaSy_your_api_key_here

# n8n webhook base URL (your ngrok URL, no trailing slash)
VITE_N8N_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app
